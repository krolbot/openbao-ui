# Address of the OpenBao instance the BFF talks to (server-side only).
# In the single Docker image this is the in-container OpenBao.
OPENBAO_ADDR=http://127.0.0.1:8200

# Name of the httpOnly cookie that stores the OpenBao token.
BAO_COOKIE_NAME=bao_token

# Public URL the app is reached at, e.g. https://bao.example.com (origin only;
# any path is ignored). OPTIONAL. By default the app derives its origin from each
# request's Host / X-Forwarded-* headers, which is correct for most setups. Set
# this when you want one fixed origin regardless of how requests arrive — e.g.
# behind a proxy/load balancer that rewrites or drops those headers. It pins the
# OIDC redirect_uri (so "Sign in with Google" works) and the post-login redirect.
# OPENBAO_UI_PUBLIC_URL=https://bao.example.com

# --- Docker entrypoint (dev mode) ---
# When BAO_DEV=1 the image boots `bao server -dev` with the root token below,
# so the login flow works out of the box. Do NOT use dev mode in production.
BAO_DEV=1
BAO_DEV_ROOT_TOKEN_ID=root
